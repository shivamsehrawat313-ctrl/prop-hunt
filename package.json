{
  "name": "shadow-hunt",
  "private": true,
  "type": "module",
  "scripts": {
    "dev": "concurrently -k -n client,server -c cyan,magenta \"vite --config vite.config.js --configLoader runner\" \"node server/index.js\"",
    "build": "vite build --config vite.config.js --configLoader runner",
    "start": "node server/index.js",
    "preview": "vite preview --config vite.config.js --configLoader runner",
    "server": "node server/index.js",
    "test:multiplayer": "node tools/test-multiplayer.js",
    "test:vision": "node tools/test-vision.js",
    "test:audio": "node tools/test-audio.js",
    "test:mobile": "node tools/test-mobile-layout.js",
    "test:production-css": "node tools/test-production-css.js",
    "test": "npm run test:multiplayer && npm run test:vision && npm run test:audio && npm run test:mobile"
  },
  "dependencies": {
    "socket.io": "^4.8.1",
    "socket.io-client": "^4.8.4",
    "three": "^0.180.0"
  },
  "devDependencies": {
    "concurrently": "^9.2.1",
    "vite": "^7.1.7"
  }
}
